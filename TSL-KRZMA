-- Identification du chasseur
-- Cherche des attributs/valeurs de role et
-- des indicateurs rouges proches du personnage.

local hunterWords = {
    "hunter", "killer", "chaser",
    "chasseur", "tueur", "tagger"
}

local roleKeys = {
    "Role", "CurrentRole", "PlayerRole",
    "TeamRole", "IsHunter", "IsKiller",
    "IsChaser", "Hunter", "Killer",
    "Chasseur", "Tueur"
}

local function hunterValue(value)
    if type(value) == "boolean" then
        return value
    end

    if type(value) == "string" then
        local lower = value:lower()
        for _, word in ipairs(hunterWords) do
            if lower:find(word, 1, true) then
                return true
            end
        end
    end

    return false
end

local function roleMatches(instance)
    for _, key in ipairs(roleKeys) do
        local attr = instance:GetAttribute(key)
        if hunterValue(attr) then
            return true
        end

        local child = instance:FindFirstChild(key)
        if child and child:IsA("ValueBase") then
            if hunterValue(child.Value) then
                return true
            end
        end
    end

    return false
end

local function redColor(color)
    return color.R > 0.65
        and color.R > color.G * 1.45
        and color.R > color.B * 1.35
end

local function hasRedIndicator(char)
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return false end

    for _, obj in ipairs(char:GetDescendants()) do
        if obj:IsA("Highlight") then
            if obj.Enabled and (
                redColor(obj.FillColor) or
                redColor(obj.OutlineColor)
            ) then
                return true
            end

        elseif obj:IsA("SelectionBox") or
            obj:IsA("SelectionSphere") then
            if redColor(obj.Color3) then
                return true
            end

        elseif obj:IsA("BasePart") then
            local name = obj.Name:lower()
            local indicatorName =
                name:find("circle", 1, true) or
                name:find("ring", 1, true) or
                name:find("aura", 1, true) or
                name:find("zone", 1, true) or
                name:find("radius", 1, true) or
                name:find("cercle", 1, true)

            if indicatorName and redColor(obj.Color) then
                return true
            end
        end
    end

    return false
end

local function isHunter(other)
    local char = other.Character
    if not char then return false end

    if roleMatches(other) or roleMatches(char) then
        return true
    end

    if other.Team then
        local teamName = other.Team.Name:lower()
        for _, word in ipairs(hunterWords) do
            if teamName:find(word, 1, true) then
                return true
            end
        end
    end

    return hasRedIndicator(char)
end

local function nearestHunter()
    local char = player.Character
    local root = char and
        char:FindFirstChild("HumanoidRootPart")

    if not root then return nil end

    local nearest = nil
    local shortest = radius

    for _, other in ipairs(Players:GetPlayers()) do
        if other ~= player then
            local otherChar = other.Character
            local otherRoot = otherChar and
                otherChar:FindFirstChild("HumanoidRootPart")
            local hum = otherChar and
                otherChar:FindFirstChildOfClass("Humanoid")

            if otherRoot and hum and hum.Health > 0
                and isHunter(other) then

                local offset = otherRoot.Position - root.Position
                local distance = Vector3.new(
                    offset.X, 0, offset.Z
                ).Magnitude

                if distance <= shortest then
                    shortest = distance
                    nearest = other
                end
            end
        end
    end

    return nearest
end

local function dodgeAway(target)
    local char = player.Character
    local root = char and
        char:FindFirstChild("HumanoidRootPart")
    local hum = char and
        char:FindFirstChildOfClass("Humanoid")
    local enemyRoot = target.Character and
        target.Character:FindFirstChild("HumanoidRootPart")

    if not root or not hum or not enemyRoot then
        return
    end

    local offset = root.Position - enemyRoot.Position
    local direction = Vector3.new(offset.X, 0, offset.Z)

    if direction.Magnitude < 0.01 then
        local back = -root.CFrame.LookVector
        direction = Vector3.new(back.X, 0, back.Z)
    end

    if direction.Magnitude > 0 then
        hum:Move(direction.Unit, false)
    end
end

connect(RunService.Heartbeat, function(dt)
    if not running then return end

    local cam = workspace.CurrentCamera
    if cam and math.abs(cam.FieldOfView - fov) > 0.1 then
        cam.FieldOfView = fov
    end

    local char = player.Character
    local root = char and
        char:FindFirstChild("HumanoidRootPart")

    if root then
        zone.Size = Vector3.new(
            0.12, radius * 2, radius * 2
        )
        zone.CFrame = CFrame.new(
            root.Position.X,
            root.Position.Y - 2.8,
            root.Position.Z
        ) * CFrame.Angles(0, 0, math.rad(90))

        zone.Transparency = showZone and 0.75 or 1
        outline.Visible = showZone
    else
        zone.Transparency = 1
        outline.Visible = false
    end

    elapsed = elapsed + dt
    if elapsed < 0.1 then return end
    elapsed = 0

    local target = nearestHunter()

    if target then
        zone.Color = Color3.fromRGB(255, 55, 65)
        outline.Color3 = Color3.fromRGB(255, 55, 65)

        targetText.Text = "CHASSEUR : " .. target.Name
        statusText.Text = "CHASSEUR DETECTE"
        statusText.TextColor3 = Color3.fromRGB(255, 80, 80)

        warning.Visible = true

        if enabled and os.clock() - lastDodge >= cooldown then
            lastDodge = os.clock()
            dodgeAway(target)
        end
    else
        zone.Color = Color3.fromRGB(0, 160, 255)
        outline.Color3 = Color3.fromRGB(0, 160, 255)

        targetText.Text = "CHASSEUR : AUCUN"
        statusText.Text = "ZONE SECURISEE"
        statusText.TextColor3 = Color3.fromRGB(80, 255, 150)

        warning.Visible = false
    end
end)

env.TSLKRZMACleanup = function()
    if not running then return end
    running = false
    enabled = false

    for _, c in ipairs(connections) do
        c:Disconnect()
    end

    local cam = workspace.CurrentCamera
    if cam then
        cam.FieldOfView = originalFov
    end

    gui:Destroy()
    zone:Destroy()
end

