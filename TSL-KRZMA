local function toggle(text, y, initial, callback)
    local state = initial
    local b = button(
        frame, "", 15, y, 285, 32,
        Color3.fromRGB(165, 45, 55)
    )

    local function refresh()
        b.Text = text .. (state and " : ON" or " : OFF")
        b.BackgroundColor3 = state
            and Color3.fromRGB(30, 155, 90)
            or Color3.fromRGB(165, 45, 55)
    end

    refresh()

    connect(b.MouseButton1Click, function()
        state = not state
        refresh()
        callback(state)
    end)
end

local function slider(y, min, max, initial, callback)
    local bar = button(
        frame, "", 15, y, 285, 14,
        Color3.fromRGB(65, 70, 85)
    )
    bar.AutoButtonColor = false

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(
        math.clamp((initial - min) / (max - min), 0, 1),
        0, 1, 0
    )
    fill.BackgroundColor3 = Color3.fromRGB(0, 160, 255)
    fill.BorderSizePixel = 0
    fill.Parent = bar
    corner(fill, 7)

    local activeInput = nil
    local mouseDragging = false

    local function update(x)
        local ratio = math.clamp(
            (x - bar.AbsolutePosition.X)
            / math.max(bar.AbsoluteSize.X, 1),
            0, 1
        )
        fill.Size = UDim2.new(ratio, 0, 1, 0)
        callback(min + (max - min) * ratio)
    end

    connect(bar.InputBegan, function(input)
        if input.UserInputType == Enum.UserInputType.Touch then
            activeInput = input
            update(input.Position.X)
        elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
            mouseDragging = true
            update(input.Position.X)
        end
    end)

    connect(UIS.InputChanged, function(input)
        if activeInput and input == activeInput then
            update(input.Position.X)
        elseif mouseDragging and
            input.UserInputType == Enum.UserInputType.MouseMovement then
            update(input.Position.X)
        end
    end)

    connect(UIS.InputEnded, function(input)
        if input == activeInput then
            activeInput = nil
        elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
            mouseDragging = false
        end
    end)
end

