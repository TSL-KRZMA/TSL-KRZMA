local function makeToggle(text, y, initial, callback)
    local b = Instance.new("TextButton")
    b.Size = UDim2.fromOffset(285, 32)
    b.Position = UDim2.fromOffset(15, y)
    b.TextColor3 = Color3.new(1, 1, 1)
    b.TextSize = 14
    b.Font = Enum.Font.GothamBold
    b.Parent = frame
    round(b, 7)

    local active = initial

    local function refresh()
        b.Text = text .. (active and " : ON" or " : OFF")
        b.BackgroundColor3 = active
            and Color3.fromRGB(30, 155, 90)
            or Color3.fromRGB(165, 45, 55)
    end

    refresh()

    connect(b.MouseButton1Click, function()
        active = not active
        refresh()
        callback(active)
    end)

    return b
end

-- Curseur compatible tactile
local function makeSlider(y, min, max, initial, callback)
    local bar = Instance.new("TextButton")
    bar.Size = UDim2.fromOffset(285, 14)
    bar.Position = UDim2.fromOffset(15, y)
    bar.BackgroundColor3 = Color3.fromRGB(65, 70, 85)
    bar.Text = ""
    bar.AutoButtonColor = false
    bar.Parent = frame
    round(bar, 7)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(
        (initial-min)/(max-min), 0, 1, 0
    )
    fill.BackgroundColor3 = Color3.fromRGB(0, 160, 255)
    fill.BorderSizePixel = 0
    fill.Parent = bar
    round(fill, 7)

    local dragging = false
    local activeTouch = nil

    local function update(x)
        local ratio = math.clamp(
            (x - bar.AbsolutePosition.X)
            / math.max(bar.AbsoluteSize.X, 1),
            0, 1
        )

        fill.Size = UDim2.new(ratio, 0, 1, 0)
        callback(min + (max-min)*ratio)
    end

    connect(bar.InputBegan, function(input)
        if input.UserInputType ==
            Enum.UserInputType.Touch then
            activeTouch = input
            dragging = true
            update(input.Position.X)

        elseif input.UserInputType ==
            Enum.UserInputType.MouseButton1 then
            dragging = true
            update(input.Position.X)
        end
    end)

    connect(UIS.InputChanged, function(input)
        if not dragging then return end

        if input == activeTouch or (
            not activeTouch and
            input.UserInputType ==
            Enum.UserInputType.MouseMovement
        ) then
            update(input.Position.X)
        end
    end)

    connect(UIS.InputEnded, function(input)
        if input == activeTouch or (
            not activeTouch and
            input.UserInputType ==
            Enum.UserInputType.MouseButton1
        ) then
            dragging = false
            activeTouch = nil
        end
    end)
end

