local function draggable(handle, object, onTap)
    local dragging = false
    local inputStart = nil
    local startPos = nil
    local objectStart = nil
    local moved = false

    connect(handle.InputBegan, function(input)
        if input.UserInputType == Enum.UserInputType.Touch or
            input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            inputStart = input
            startPos = input.Position
            objectStart = object.Position
            moved = false
        end
    end)

    connect(UIS.InputChanged, function(input)
        if not dragging then return end

        local valid = input == inputStart or (
            inputStart and
            inputStart.UserInputType == Enum.UserInputType.MouseButton1 and
            input.UserInputType == Enum.UserInputType.MouseMovement
        )

        if valid then
            local delta = input.Position - startPos
            if delta.Magnitude > 8 then moved = true end

            object.Position = UDim2.new(
                objectStart.X.Scale,
                objectStart.X.Offset + delta.X,
                objectStart.Y.Scale,
                objectStart.Y.Offset + delta.Y
            )
        end
    end)

    connect(UIS.InputEnded, function(input)
        if dragging and input == inputStart then
            dragging = false
            if not moved and onTap then onTap() end
            inputStart = nil
        end
    end)
end

