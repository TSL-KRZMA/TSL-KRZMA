-- DETECTION DU JOUEUR LE PLUS PROCHE
local function nearestPlayer()
    local char = player.Character
    local root = char and
        char:FindFirstChild("HumanoidRootPart")

    if not root then return nil end

    local nearest = nil
    local shortest = radius

    for _, other in ipairs(Players:GetPlayers()) do
        if other ~= player then
            local otherChar = other.Character

            local otherRoot = otherChar and
                otherChar:FindFirstChild("HumanoidRootPart")

            local hum = otherChar and
                otherChar:FindFirstChildOfClass("Humanoid")

            if otherRoot and hum and hum.Health > 0 then
                local offset =
                    otherRoot.Position - root.Position

                local distance = Vector3.new(
                    offset.X, 0, offset.Z
                ).Magnitude

                if distance <= shortest then
                    shortest = distance
                    nearest = other
                end
            end
        end
    end

    return nearest
end

-- AUTO DODGE EXPERIMENTAL
local function dodgeAway(target)
    local char = player.Character

    local root = char and
        char:FindFirstChild("HumanoidRootPart")

    local hum = char and
        char:FindFirstChildOfClass("Humanoid")

    local enemyRoot = target.Character and
        target.Character:FindFirstChild("HumanoidRootPart")

    if not root or not hum or not enemyRoot then
        return
    end

    local offset =
        root.Position - enemyRoot.Position

    local direction = Vector3.new(
        offset.X, 0, offset.Z
    )

    if direction.Magnitude < 0.01 then
        local backward = -root.CFrame.LookVector

        direction = Vector3.new(
            backward.X, 0, backward.Z
        )
    end

    if direction.Magnitude > 0 then
        hum:Move(direction.Unit, false)
    end
end

-- BOUCLE PRINCIPALE
connect(RunService.Heartbeat, function(dt)
    if not running then return end

    local char = player.Character
    local root = char and
        char:FindFirstChild("HumanoidRootPart")

    if root then
        zone.Size = Vector3.new(
            0.12, radius*2, radius*2
        )

        zone.CFrame =
            CFrame.new(
                root.Position.X,
                root.Position.Y - 2.8,
                root.Position.Z
            ) * CFrame.Angles(0, 0, math.rad(90))

        zone.Transparency =
            showZone and 0.75 or 1

        zoneOutline.Visible = showZone
    else
        zone.Transparency = 1
        zoneOutline.Visible = false
    end

    elapsed = elapsed + dt
    if elapsed < 0.1 then return end
    elapsed = 0

    local target = nearestPlayer()

    if target then
        zone.Color =
            Color3.fromRGB(255, 55, 65)

        zoneOutline.Color3 =
            Color3.fromRGB(255, 55, 65)

        targetLabel.Text =
            "JOUEUR : " .. target.Name

        alertLabel.Text =
            "ATTENTION : JOUEUR PROCHE"

        alertLabel.TextColor3 =
            Color3.fromRGB(255, 80, 80)

        warning.Text =
            "ALERTE : " .. target.Name

        warning.Visible = true

        if enabled and
            os.clock() - lastDodge >= cooldown then

            lastDodge = os.clock()
            dodgeAway(target)
        end
    else
        zone.Color =
            Color3.fromRGB(0, 160, 255)

        zoneOutline.Color3 =
            Color3.fromRGB(0, 160, 255)

        targetLabel.Text =
            "JOUEUR : AUCUN"

        alertLabel.Text =
            "ZONE SECURISEE"

        alertLabel.TextColor3 =
            Color3.fromRGB(80, 255, 150)

        warning.Visible = false
    end
end)

-- FERMETURE COMPLETE
env.TSLKRZMACleanup = function()
    if not running then return end

    running = false
    enabled = false

    for _, c in ipairs(connections) do
        c:Disconnect()
    end

    local cam = workspace.CurrentCamera
    if cam then
        cam.FieldOfView = originalFov
    end

    gui:Destroy()
    zone:Destroy()
end

